<!DOCTYPE html>
<html lang="en">
  <%- include("./components/head.ejs") %>
  <body>
    <%- include("./components/navbar.ejs") %>

    <div class="container">
      <% if (blogs.length) { %> <% blogs.forEach(blog => { %>
      <div class="blog-card">
        <h2><%= blog.title %></h2>
        <p><%= blog.intro %></p>
      </div>
      <% }) %> <% } %>
    </div>
  </body>
</html>
